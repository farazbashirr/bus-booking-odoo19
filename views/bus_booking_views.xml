<odoo>
    <data>
        <!-- List View for bus.booking -->
        <record id="bus_booking_list" model="ir.ui.view">
            <field name="name">bus.booking.list</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <list decoration-muted="state == 'draft'"
                      decoration-success="state == 'confirmed'"
                      decoration-danger="state == 'cancelled'">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="trip_id"/>
                    <field name="seat_count"/>
                    <field name="total_fare"/>
                    <field name="payment_status"/>
                    <field name="state" widget="badge"
                           decoration-muted="state == 'draft'"
                           decoration-success="state == 'confirmed'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <!-- Form View for bus.booking -->
        <record id="bus_booking_form" model="ir.ui.view">
            <field name="name">bus.booking.form</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Confirm Booking"
                                name="action_confirm"
                                type="object"
                                class="oe_highlight"
                                confirm="Confirm this booking and generate an invoice?"
                                invisible="state != 'draft'"/>
                        <button string="Cancel"
                                name="action_cancel"
                                type="object"
                                confirm="Cancel this booking? This will release the reserved seat(s)."
                                invisible="state == 'cancelled'"/>
                        <button string="Print Ticket"
                                type="action"
                                name="%(bus_booking.action_report_bus_ticket)d"
                                class="oe_highlight"
                                invisible="state != 'confirmed'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="customer_id"/>
                                <field name="trip_id"/>
                                <field name="booking_date"/>
                            </group>
                            <group>
                                <field name="seat_count"/>
                                <field name="fare_per_seat"/>
                                <field name="total_fare"/>
                                <field name="payment_status"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Seats">
                            <field name="booking_seat_ids"
                                   widget="many2many_tags"
                                   domain="[('trip_id', '=', trip_id), '|', ('state', '=', 'available'), ('id', 'in', booking_seat_ids)]"
                                   options="{'no_create': True}"
                                   required="state == 'draft'"/>
                        </group>
                        <group string="Invoice" invisible="not invoice_id">
                            <field name="invoice_id" readonly="1"/>
                            <button string="Open Invoice"
                                    type="object"
                                    name="action_view_invoice"
                                    class="oe_link"
                                    invisible="not invoice_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="bus_booking_action" model="ir.actions.act_window">
            <field name="name">Bookings</field>
            <field name="res_model">bus.booking</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
