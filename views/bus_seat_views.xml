<odoo>
    <data>
        <!-- List View for bus.seat -->
        <record id="bus_seat_list" model="ir.ui.view">
            <field name="name">bus.seat.list</field>
            <field name="model">bus.seat</field>
            <field name="arch" type="xml">
                <list>
                    <field name="seat_number"/>
                    <field name="seat_type"/>
                    <field name="vehicle_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for bus.seat -->
        <record id="bus_seat_form" model="ir.ui.view">
            <field name="name">bus.seat.form</field>
            <field name="model">bus.seat</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="seat_number"/>
                            <field name="seat_type"/>
                            <field name="vehicle_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="bus_seat_action" model="ir.actions.act_window">
            <field name="name">Seats</field>
            <field name="res_model">bus.seat</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>