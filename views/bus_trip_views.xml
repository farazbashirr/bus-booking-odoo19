<odoo>
    <data>
        <!-- List View for bus.trip -->
        <record id="bus_trip_list" model="ir.ui.view">
            <field name="name">bus.trip.list</field>
            <field name="model">bus.trip</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="route_id"/>
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                    <field name="departure_datetime"/>
                    <field name="fare"/>
                    <field name="state"/>
                    <field name="available_seats_count"/>
                </list>
            </field>
        </record>

        <!-- Form View for bus.trip -->
        <record id="bus_trip_form" model="ir.ui.view">
            <field name="name">bus.trip.form</field>
            <field name="model">bus.trip</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Confirm"
                                name="action_confirm"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button string="Start Trip"
                                name="action_start_trip"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'scheduled'"/>
                        <button string="Complete"
                                name="action_complete"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'departed'"/>
                        <button string="Cancel"
                                name="action_cancel"
                                type="object"
                                invisible="state in ('completed', 'cancelled')"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="route_id"/>
                                <field name="vehicle_id"/>
                                <field name="driver_id"/>
                            </group>
                            <group>
                                <field name="departure_datetime"/>
                                <field name="arrival_datetime"/>
                                <field name="fare"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="total_seats"/>
                                <field name="available_seats_count"/>
                                <field name="booked_seats_count"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Seats" name="seats">
                                <field name="trip_seat_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="seat_number"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="bus_trip_action" model="ir.actions.act_window">
            <field name="name">Trips</field>
            <field name="res_model">bus.trip</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
