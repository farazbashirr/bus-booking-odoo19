<odoo>
    <data>
        <!-- Occupancy Graph View -->
        <record id="view_occupancy_graph" model="ir.ui.view">
            <field name="name">bus.trip.graph</field>
            <field name="model">bus.trip</field>
            <field name="arch" type="xml">
                <graph string="Occupancy by Route" type="bar">
                    <field name="route_id" type="row"/>
                    <field name="occupancy_rate" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Occupancy Pivot View -->
        <record id="view_occupancy_pivot" model="ir.ui.view">
            <field name="name">bus.trip.occupancy.pivot</field>
            <field name="model">bus.trip</field>
            <field name="arch" type="xml">
                <pivot string="Occupancy Pivot">
                    <field name="route_id" type="row"/>
                    <field name="state" type="col"/>
                    <field name="booked_seats_count" type="measure"/>
                    <field name="occupancy_rate" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Occupancy Report Action -->
        <record id="action_occupancy_report" model="ir.actions.act_window">
            <field name="name">Occupancy Report</field>
            <field name="res_model">bus.trip</field>
            <field name="view_mode">graph,pivot,list</field>
        </record>
    </data>
</odoo>
