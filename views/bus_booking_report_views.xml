<odoo>
    <data>
        <!-- Revenue Graph View -->
        <record id="view_revenue_graph" model="ir.ui.view">
            <field name="name">bus.booking.graph</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <graph string="Revenue by Route" type="bar">
                    <field name="route_name" type="row"/>
                    <field name="total_fare" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Revenue Pivot View -->
        <record id="view_revenue_pivot" model="ir.ui.view">
            <field name="name">bus.booking.pivot</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <pivot string="Revenue Pivot">
                    <field name="route_name" type="row"/>
                    <field name="trip_date" type="col" interval="month"/>
                    <field name="total_fare" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Revenue Report Action -->
        <record id="action_revenue_report" model="ir.actions.act_window">
            <field name="name">Revenue Report</field>
            <field name="res_model">bus.booking</field>
            <field name="view_mode">pivot,graph,list</field>
            <field name="domain">[('state', '=', 'confirmed')]</field>
            <field name="context">{'search_default_group_by_route_name': 1}</field>
        </record>

        <!-- Today's Bookings Action -->
        <record id="action_today_bookings" model="ir.actions.act_window">
            <field name="name">Today's Bookings</field>
            <field name="res_model">bus.booking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('trip_date','&gt;=',context_today().strftime('%%Y-%%m-%%d 00:00:00')),('trip_date','&lt;',context_today().strftime('%%Y-%%m-%%d') + ' 1 day')]</field>
        </record>
    </data>
</odoo>
