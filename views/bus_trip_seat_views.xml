<odoo>
    <data>
        <!-- List View for bus.trip.seat -->
        <record id="bus_trip_seat_list" model="ir.ui.view">
            <field name="name">bus.trip.seat.list</field>
            <field name="model">bus.trip.seat</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'available'"
                      decoration-info="state == 'booked'"
                      decoration-warning="state == 'blocked'">
                    <field name="trip_id"/>
                    <field name="seat_number"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'available'"
                           decoration-info="state == 'booked'"
                           decoration-warning="state == 'blocked'"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
