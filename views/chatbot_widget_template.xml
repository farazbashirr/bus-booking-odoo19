<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Offline FAQ Chatbot Widget (Phase 8)                          -->
    <!-- Floating button + panel, wired up by static/src/js/chatbot.js   -->
    <!-- Markup only - styling lives in                                -->
    <!-- static/src/css/chatbot_widget.css (web.assets_frontend) so it -->
    <!-- survives any inline <style> stripping/bypass on portal pages.  -->
    <!-- ============================================================ -->
    <template id="chatbot_widget" name="Offline FAQ Chatbot Widget">
        <div id="bbb-chat-widget">
            <button type="button" class="bbb-chat-toggle btn btn-primary" aria-label="Chat with support">
                <i class="fa fa-comments"/>
            </button>
            <div class="bbb-chat-panel d-none">
                <div class="bbb-chat-header">
                    <i class="fa fa-life-ring me-1"/> Support Assistant
                    <br/>
                    <small>Offline FAQ help - no internet needed</small>
                </div>
                <div class="bbb-chat-messages"/>
                <div class="bbb-chat-input">
                    <input type="text" class="form-control" placeholder="Type your question..."
                           aria-label="Your question" autocomplete="off"/>
                    <button type="button" class="bbb-chat-send btn btn-primary">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- Phase 8 fix: attach the floating widget to every portal page   -->
    <!-- (portal.portal_layout is used by /my, /my/home, invoices,     -->
    <!-- etc. — the 4 custom bus pages included).                      -->
    <!-- ============================================================ -->
    <template id="portal_layout_chatbot_widget"
              name="Portal Layout: Floating Chatbot Widget"
              inherit_id="portal.portal_layout"
              priority="50">
        <xpath expr="//div[@id='wrap']" position="inside">
            <t t-call="bus_booking.chatbot_widget"/>
        </xpath>
    </template>

</odoo>