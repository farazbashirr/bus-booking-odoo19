<odoo>
    <data>
        <!-- List View for bus.vehicle -->
        <record id="bus_vehicle_list" model="ir.ui.view">
            <field name="name">bus.vehicle.list</field>
            <field name="model">bus.vehicle</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="registration_no"/>
                    <field name="vehicle_type"/>
                    <field name="total_seats"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Form View for bus.vehicle -->
        <record id="bus_vehicle_form" model="ir.ui.view">
            <field name="name">bus.vehicle.form</field>
            <field name="model">bus.vehicle</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="registration_no"/>
                            <field name="vehicle_type"/>
                            <field name="total_seats"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group name="seat_buttons" string="Actions">
                            <button string="Generate Seats"
                                    name="action_generate_seats"
                                    type="object"
                                    help="Creates seat records based on Total Seats. Only works if no seats exist yet."
                                    class="oe_highlight"/>
                        </group>
                        <notebook>
                            <page string="Seats" name="seats">
                                <field name="seat_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="bus_vehicle_action" model="ir.actions.act_window">
            <field name="name">Vehicles</field>
            <field name="res_model">bus.vehicle</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>