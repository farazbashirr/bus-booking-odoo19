<odoo>
    <data>
        <!-- List View for bus.driver -->
        <record id="bus_driver_list" model="ir.ui.view">
            <field name="name">bus.driver.list</field>
            <field name="model">bus.driver</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="license_no"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View for bus.driver -->
        <record id="bus_driver_form" model="ir.ui.view">
            <field name="name">bus.driver.form</field>
            <field name="model">bus.driver</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="license_no"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="bus_driver_action" model="ir.actions.act_window">
            <field name="name">Drivers</field>
            <field name="res_model">bus.driver</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>